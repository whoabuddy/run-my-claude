{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "run-my-claude",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],

  // Environment variables
  "vars": {
    "X402_NETWORK": "mainnet",
    "X402_SERVER_ADDRESS": "SP31JEZWX4S131326VKM05QKJ0TDGNVVE0CDWWVA2",
    "X402_FACILITATOR_URL": "https://facilitator.x402stacks.xyz",
    "CLAUDE_EXECUTOR": "workers-ai",
    "MAX_JOB_DURATION_MS": "60000"
  },

  // Workers AI binding
  "ai": {
    "binding": "AI"
  },

  // Durable Objects for stateful operations
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_DO",
        "class_name": "JobDurableObject"
      },
      {
        "name": "USER_DO",
        "class_name": "UserDurableObject"
      }
    ]
  },

  // SQLite for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JobDurableObject", "UserDurableObject"]
    }
  ],

  // KV namespaces
  "kv_namespaces": [
    {
      "binding": "METRICS",
      "id": "PLACEHOLDER_METRICS_ID"
    },
    {
      "binding": "PRODUCTS",
      "id": "PLACEHOLDER_PRODUCTS_ID"
    }
  ],

  // Staging environment (testnet)
  "env": {
    "staging": {
      "name": "run-my-claude-staging",
      "vars": {
        "X402_NETWORK": "testnet",
        "X402_SERVER_ADDRESS": "ST31JEZWX4S131326VKM05QKJ0TDGNVVE0DGNM4BP",
        "X402_FACILITATOR_URL": "https://facilitator.x402stacks.xyz"
      },
      "kv_namespaces": [
        {
          "binding": "METRICS",
          "id": "PLACEHOLDER_STAGING_METRICS_ID"
        },
        {
          "binding": "PRODUCTS",
          "id": "PLACEHOLDER_STAGING_PRODUCTS_ID"
        }
      ]
    }
  }
}

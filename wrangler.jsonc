{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "run-my-claude",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-06",
  "compatibility_flags": ["nodejs_compat"],

  // Observability for automatic logging
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Environment variables
  "vars": {
    "X402_NETWORK": "mainnet",
    "X402_SERVER_ADDRESS": "SP31JEZWX4S131326VKM05QKJ0TDGNVVE0CDWWVA2",
    "X402_FACILITATOR_URL": "https://facilitator.x402stacks.xyz",
    "CLAUDE_EXECUTOR": "workers-ai",
    "MAX_JOB_DURATION_MS": "60000"
  },

  // Workers AI binding
  "ai": {
    "binding": "AI"
  },

  // Durable Objects for stateful operations
  "durable_objects": {
    "bindings": [
      {
        "name": "JOB_DO",
        "class_name": "JobDurableObject"
      },
      {
        "name": "USER_DO",
        "class_name": "UserDurableObject"
      }
    ]
  },

  // SQLite for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JobDurableObject", "UserDurableObject"]
    }
  ],

  // KV namespaces - Create with:
  //   wrangler kv namespace create METRICS
  //   wrangler kv namespace create PRODUCTS
  // Then replace the placeholder IDs below
  "kv_namespaces": [
    {
      "binding": "METRICS",
      "id": "beb9d32251c245b282651be6127ee1f9"
    },
    {
      "binding": "PRODUCTS",
      "id": "c33bb7effc7d41359d3aeb2583b4e316"
    }
  ],

  // Staging environment (testnet)
  "env": {
    "staging": {
      "name": "run-my-claude-staging",
      "vars": {
        "X402_NETWORK": "testnet",
        "X402_SERVER_ADDRESS": "ST31JEZWX4S131326VKM05QKJ0TDGNVVE0DGNM4BP",
        "X402_FACILITATOR_URL": "https://facilitator.x402stacks.xyz",
        "CLAUDE_EXECUTOR": "workers-ai",
        "MAX_JOB_DURATION_MS": "60000"
      },
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "JOB_DO",
            "class_name": "JobDurableObject"
          },
          {
            "name": "USER_DO",
            "class_name": "UserDurableObject"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "METRICS",
          "id": "16fd8a886bda4e948c11532edb5ad8bc"
        },
        {
          "binding": "PRODUCTS",
          "id": "395337307ff14dfa86298ab0f4acd91c"
        }
      ]
    }
  }
}
